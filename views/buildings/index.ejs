<%- include('../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <%- include('../partials/alerts') %>

  <div class="flex flex-col gap-4 mb-6 pb-4 border-b border-slate-200 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900">Campus Buildings</h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-1">Manage buildings and floor plan maps</p>
    </div>
    <% if (user && (user.role === 'Admin' || user.role === 'Surveyor')) { %>
    <a href="/buildings/create" class="inline-flex items-center justify-center px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm rounded-lg shadow-sm transition min-h-[44px]">
      <svg class="w-4 h-4 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      Add Building
    </a>
  <% } %>
  </div>

  <!-- Mobile: 1 col, sm: 2 col, lg: 3 col -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
    <% if (buildings && buildings.length > 0) { %>
      <% buildings.forEach(b => { %>
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col hover:shadow-md transition">
          <div class="p-5">
            <div class="flex items-center justify-between mb-2">
              <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-xs font-bold font-mono rounded-md uppercase tracking-wider truncate max-w-[120px]"><%= b.code %></span>
              <span class="flex-shrink-0 text-xs text-slate-500 font-medium ml-2"><%= b.floor_count %> Floor(s)</span>
            </div>
            <h3 class="text-base font-bold text-slate-900 mt-2 mb-1 leading-tight"><%= b.name %></h3>
            <p class="text-xs text-slate-500 flex items-start gap-1">
              <svg class="w-3.5 h-3.5 mt-0.5 flex-shrink-0 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
              <span><%= b.location || 'University Main Campus' %></span>
            </p>

            <div class="mt-3 pt-3 border-t border-slate-100">
              <span class="text-xs font-semibold text-slate-600 block mb-2">Floors:</span>
              <div class="flex flex-wrap gap-1.5">
                <% (b.floors || []).forEach(f => { %>
                  <span class="px-2 py-0.5 bg-slate-50 border border-slate-200 text-slate-700 text-xs rounded font-medium">Floor <%= f.floor_number %></span>
                <% }); %>
                <% if (!b.floors || b.floors.length === 0) { %>
                  <span class="text-xs text-slate-400 italic">No floor plan yet</span>
                <% } %>
              </div>
            </div>
          </div>

          <div class="bg-slate-50 px-5 py-3 border-t border-slate-100 flex items-center justify-between mt-auto">
            <a href="/buildings/<%= b.building_id %>" class="text-xs font-bold text-emerald-600 hover:text-emerald-700 flex items-center min-h-[36px]">
              Manage Floors &rarr;
            </a>
            <% if (user && user.role === 'Admin') { %>
              <form action="/buildings/<%= b.building_id %>/delete" method="POST" onsubmit="return confirm('Delete building \"<%= b.name %>\" and ALL its floor plans & surveys? This cannot be undone.')">
                <button type="submit" class="text-xs font-semibold text-red-600 hover:text-red-800 min-h-[36px] px-1">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-span-full bg-white p-8 rounded-xl border border-slate-200 text-center">
        <svg class="w-10 h-10 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"></path></svg>
        <p class="text-slate-500 text-sm">No campus buildings created yet.</p>
        <% if (user && (user.role === 'Admin' || user.role === 'Surveyor')) { %>
          <a href="/buildings/create" class="mt-3 inline-block text-xs font-semibold text-emerald-600 hover:text-emerald-700">Add the first building &rarr;</a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
