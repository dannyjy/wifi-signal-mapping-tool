<%- include('../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <%- include('../partials/alerts') %>

  <!-- Breadcrumb & Header -->
  <div class="mb-5">
    <a href="/buildings" class="text-xs font-semibold text-slate-500 hover:text-slate-700 inline-flex items-center mb-3 min-h-[36px]">
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      Back to Campus Buildings
    </a>
    <div class="flex flex-col gap-3 pb-4 border-b border-slate-200 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2.5 py-1 bg-slate-900 text-emerald-400 text-xs font-mono font-bold rounded uppercase"><%= building.code %></span>
          <h1 class="text-xl sm:text-2xl font-bold text-slate-900 leading-tight"><%= building.name %></h1>
        </div>
        <p class="text-xs text-slate-500 mt-1"><%= building.location || 'Main Campus' %></p>
      </div>
    </div>
  </div>

  <div class="flex flex-col lg:flex-row gap-6">
    <!-- Floor Plans List -->
    <div class="flex-1 space-y-4">
      <h2 class="text-base sm:text-lg font-bold text-slate-900">Uploaded Floor Plans</h2>

      <% if (building.floors && building.floors.length > 0) { %>
        <% building.floors.forEach(floor => { %>
          <div class="bg-white p-4 sm:p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center gap-4">
              <!-- Preview Thumbnail -->
              <div class="w-full sm:w-40 h-28 bg-slate-100 rounded-lg overflow-hidden border border-slate-200 flex items-center justify-center flex-shrink-0 p-2">
                <img src="<%= floor.image_path %>" alt="Floor <%= floor.floor_number %>" class="max-h-full max-w-full object-contain">
              </div>

              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="text-base font-bold text-slate-900">Floor <%= floor.floor_number %></h3>
                  <% if (user && user.role === 'Admin') { %>
                    <form action="/floors/<%= floor.floor_id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this floor plan and all associated surveys?')">
                      <button type="submit" class="text-xs font-semibold text-red-600 hover:text-red-800 min-h-[36px] px-1">Delete</button>
                    </form>
                  <% } %>
                </div>
                <div class="mt-1.5 text-xs text-slate-600 space-y-1">
                  <p><span class="font-semibold text-slate-700">Scale Factor:</span> <%= floor.scale_factor %> px/m</p>
                  <p><span class="font-semibold text-slate-700">Access Points:</span> <%= (floor.aps || []).length %></p>
                </div>
                <div class="mt-3">
                  <% if (user && (user.role === 'Admin' || user.role === 'Surveyor')) { %>
                    <a href="/surveys/new?building_id=<%= building.building_id %>&floor_id=<%= floor.floor_id %>" class="inline-flex items-center px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-md shadow-sm transition min-h-[40px]">
                      + Start Survey on Floor <%= floor.floor_number %>
                    </a>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="bg-white p-8 rounded-xl border border-slate-200 text-center">
          <p class="text-slate-500 text-sm">No floor plans uploaded yet.</p>
        </div>
      <% } %>
    </div>

    <!-- Upload Form (full width on mobile, sidebar on desktop) -->
    <% if (user && (user.role === 'Admin' || user.role === 'Surveyor')) { %>
    <div class="bg-white p-5 sm:p-6 rounded-xl border border-slate-200 shadow-sm lg:w-72 xl:w-80 h-fit">
      <h3 class="text-base font-bold text-slate-900 mb-4">Upload New Floor Plan</h3>
      <form action="/buildings/<%= building.building_id %>/floors" method="POST" enctype="multipart/form-data" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Floor Number</label>
          <input type="number" name="floor_number" min="1" max="100" value="1" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Scale Factor (px/m)</label>
          <input type="number" step="0.1" name="scale_factor" value="15.0" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          <p class="text-[11px] text-slate-400 mt-1">Pixels per meter for spatial accuracy.</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Floor Plan Image</label>
          <input type="file" name="floor_image" accept="image/*" required class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-slate-900 file:text-white hover:file:bg-slate-800">
        </div>

        <button type="submit" class="w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm rounded-lg shadow-sm transition min-h-[44px]">
          Upload Floor Map
        </button>
      </form>
    </div>
    <% } else { %>
      <div class="bg-white p-5 sm:p-6 rounded-xl border border-slate-200 shadow-sm lg:w-72 xl:w-80 h-fit text-center">
        <p class="text-sm text-slate-500">You have view-only access. Contact an administrator to upload floor plans.</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
