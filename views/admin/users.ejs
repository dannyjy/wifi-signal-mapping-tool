<%- include('../partials/header') %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <%- include('../partials/alerts') %>

  <div class="flex flex-col gap-4 mb-6 pb-4 border-b border-slate-200 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900">User Management</h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-1">View all registered users, change their roles, or remove accounts</p>
    </div>
    <a href="/dashboard" class="inline-flex items-center justify-center px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm rounded-lg transition min-h-[44px]">
      Back to Dashboard
    </a>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-[700px]">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
            <th class="py-3 px-4">Username</th>
            <th class="py-3 px-4">Email</th>
            <th class="py-3 px-4">Role</th>
            <th class="py-3 px-4">Registered</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% if (users && users.length > 0) { %>
            <% users.forEach(u => { %>
              <tr class="hover:bg-slate-50 transition">
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-slate-800 text-white flex items-center justify-center text-xs font-bold uppercase flex-shrink-0">
                      <%= u.username.charAt(0) %>
                    </div>
                    <div class="min-w-0">
                      <span class="font-bold text-slate-900 block truncate">
                        <%= u.username %>
                        <% if (u.user_id === user.user_id) { %>
                          <span class="text-[10px] font-semibold text-emerald-600 uppercase">(You)</span>
                        <% } %>
                      </span>
                    </div>
                  </div>
                </td>
                <td class="py-3.5 px-4 text-slate-600"><%= u.email %></td>
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-1 text-xs font-bold rounded-full <%= u.role === 'Admin' ? 'bg-slate-900 text-emerald-400' : u.role === 'Surveyor' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-700' %>">
                    <%= u.role %>
                  </span>
                </td>
                <td class="py-3.5 px-4 text-xs text-slate-500"><%= u.created_at ? new Date(u.created_at).toLocaleDateString() : 'N/A' %></td>
                <td class="py-3.5 px-4">
                  <div class="flex flex-wrap items-center gap-2 justify-end">
                    <form action="/admin/users/<%= u.user_id %>/role" method="POST" class="flex items-center gap-1.5">
                      <select name="role" class="px-2 py-1.5 border border-slate-300 rounded-lg text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-emerald-500 <%= u.user_id === user.user_id ? 'opacity-50' : '' %>">
                        <option value="Admin" <%= u.role === 'Admin' ? 'selected' : '' %>>Admin</option>
                        <option value="Surveyor" <%= u.role === 'Surveyor' ? 'selected' : '' %>>Surveyor</option>
                        <option value="Viewer" <%= u.role === 'Viewer' ? 'selected' : '' %>>Viewer</option>
                      </select>
                      <button type="submit" <%= u.user_id === user.user_id ? 'disabled' : '' %> class="px-2.5 py-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg transition <%= u.user_id === user.user_id ? 'opacity-40 cursor-not-allowed' : '' %>">
                        Update
                      </button>
                    </form>
                    <form action="/admin/users/<%= u.user_id %>/delete" method="POST" onsubmit="return confirm('Delete user \"<%= u.username %>\"? This cannot be undone.')">
                      <button type="submit" <%= u.user_id === user.user_id ? 'disabled' : '' %> class="px-2.5 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-semibold rounded border border-red-200 transition <%= u.user_id === user.user_id ? 'opacity-40 cursor-not-allowed' : '' %>">
                        Delete
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="py-8 text-center text-slate-500 text-sm">No users registered yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>