<%- include('../partials/header') %>

<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-slate-50">
  <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-xl shadow-md border border-slate-200">
    <div class="text-center">
      <div class="mx-auto w-12 h-12 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-bold text-xl mb-3 shadow">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.14 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"></path>
        </svg>
      </div>
      <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">University Signal Survey Tool</h2>
      <p class="mt-1 text-sm text-slate-600">Enter your credentials to access the Wi-Fi mapping portal</p>
    </div>

    <%- include('../partials/alerts') %>

    <form class="mt-6 space-y-5" action="/auth/login" method="POST">
      <div>
        <label for="username" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Username</label>
        <input id="username" name="username" type="text" required class="appearance-none rounded-lg relative block w-full px-3 py-2.5 border border-slate-300 placeholder-slate-400 text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm" placeholder="e.g. johndoa">
      </div>

      <div>
        <label for="password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Password</label>
        <input id="password" name="password" type="password" required class="appearance-none rounded-lg relative block w-full px-3 py-2.5 border border-slate-300 placeholder-slate-400 text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm" placeholder="••••••••">
      </div>

      <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition shadow-sm">
        Sign In
      </button>

      <div class="mt-4 text-center">
        <p class="text-xs text-slate-500">Need an account? <a href="/auth/register" class="font-semibold text-emerald-600 hover:text-emerald-500">Register new account</a></p>
      </div>
    </form>

    <!-- <div class="mt-6 pt-4 border-t border-slate-100 bg-slate-50 p-3 rounded-md text-xs text-slate-500">
      <p class="font-semibold text-slate-700">Seeded Credentials for Testing:</p>
      <ul class="mt-1 list-disc list-inside space-y-0.5">
        <li>Admin: <span class="font-mono text-slate-800">admin</span> / <span class="font-mono text-slate-800">admin123</span></li>
        <li>Surveyor: <span class="font-mono text-slate-800">surveyor1</span> / <span class="font-mono text-slate-800">surveyor123</span></li>
      </ul>
    </div> -->
  </div>
</div>

<%- include('../partials/footer') %>
