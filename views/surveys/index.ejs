<%- include('../partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <%- include('../partials/alerts') %>

  <div class="flex flex-col gap-4 mb-5 pb-4 border-b border-slate-200 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900">Survey Sessions</h1>
      <p class="text-xs sm:text-sm text-slate-600 mt-1">All historical Wi-Fi signal strength survey sessions</p>
    </div>
    <% if (user && (user.role === 'Admin' || user.role === 'Surveyor')) { %>
    <a href="/surveys/new" class="inline-flex items-center justify-center px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm rounded-lg shadow-sm transition min-h-[44px]">
      <svg class="w-4 h-4 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      New Survey
    </a>
  <% } %>
  </div>

  <!-- Mobile card list -->
  <div class="space-y-3 sm:hidden">
    <% if (sessions && sessions.length > 0) { %>
      <% sessions.forEach(s => { %>
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
          <div class="flex items-start justify-between gap-2 mb-2">
            <div class="min-w-0">
              <p class="font-bold text-slate-900 text-sm leading-tight"><%= s.session_name %></p>
              <p class="text-xs text-slate-500 mt-0.5"><%= s.building_name %> — Floor <%= s.floor_number %></p>
            </div>
            <span class="flex-shrink-0 px-2 py-0.5 text-[10px] font-bold rounded-full <%= s.status === 'Completed' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
              <%= s.status %>
            </span>
          </div>
          <div class="flex flex-wrap gap-3 text-xs text-slate-600 mb-3">
            <span><span class="font-semibold">Pts:</span> <%= s.point_count %></span>
            <span class="font-mono font-medium <%= s.avg_rssi && parseFloat(s.avg_rssi) >= -65 ? 'text-emerald-600' : 'text-red-600' %>">
              Avg: <%= s.avg_rssi ? s.avg_rssi + ' dBm' : 'N/A' %>
            </span>
            <span class="text-slate-400"><%= new Date(s.survey_date).toLocaleDateString() %></span>
          </div>
          <div class="flex gap-2">
            <a href="/surveys/<%= s.session_id %>/workspace" class="flex-1 text-center py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg transition min-h-[40px] flex items-center justify-center">
              Workspace
            </a>
            <a href="/surveys/<%= s.session_id %>/report" class="flex-1 text-center py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-semibold rounded-lg border border-emerald-200 transition min-h-[40px] flex items-center justify-center">
              Report
            </a>
            <% if (user && user.role === 'Admin') { %>
              <form action="/surveys/<%= s.session_id %>/delete" method="POST" onsubmit="return confirm('Delete survey \"<%= s.session_name %>\" and all its measurement points?')">
                <button type="submit" class="text-xs font-semibold text-red-600 hover:text-red-800 min-h-[40px] px-1" title="Delete survey">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="bg-white p-8 rounded-xl border border-slate-200 text-center">
        <p class="text-slate-500 text-sm">No survey sessions yet.</p>
        <% if (user && (user.role === 'Admin' || user.role === 'Surveyor')) { %>
          <a href="/surveys/new" class="mt-2 inline-block text-xs font-semibold text-emerald-600 hover:text-emerald-700">Start the first survey &rarr;</a>
        <% } %>
      </div>
    <% } %>
  </div>

  <!-- Desktop table -->
  <div class="hidden sm:block bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse min-w-[700px]">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
            <th class="py-3 px-4">Session Name</th>
            <th class="py-3 px-4">Building & Floor</th>
            <th class="py-3 px-4">Surveyor</th>
            <th class="py-3 px-4">Points</th>
            <th class="py-3 px-4">Avg Signal</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4">Date</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% if (sessions && sessions.length > 0) { %>
            <% sessions.forEach(s => { %>
              <tr class="hover:bg-slate-50 transition">
                <td class="py-3.5 px-4 font-bold text-slate-900 max-w-[200px] truncate"><%= s.session_name %></td>
                <td class="py-3.5 px-4 text-slate-600">
                  <span class="font-semibold text-slate-800"><%= s.building_name %></span>
                  <span class="block text-xs text-slate-500">Floor <%= s.floor_number %></span>
                </td>
                <td class="py-3.5 px-4 text-slate-700 font-medium"><%= s.surveyor_name || 'System' %></td>
                <td class="py-3.5 px-4 text-slate-800 font-semibold"><%= s.point_count %></td>
                <td class="py-3.5 px-4 font-mono font-medium <%= s.avg_rssi && parseFloat(s.avg_rssi) >= -65 ? 'text-emerald-600' : 'text-red-600' %>">
                  <%= s.avg_rssi ? s.avg_rssi + ' dBm' : 'N/A' %>
                </td>
                <td class="py-3.5 px-4">
                  <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full <%= s.status === 'Completed' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                    <%= s.status %>
                  </span>
                </td>
                <td class="py-3.5 px-4 text-xs text-slate-500 whitespace-nowrap"><%= new Date(s.survey_date).toLocaleDateString() %></td>
                <td class="py-3.5 px-4 text-right space-x-2 whitespace-nowrap">
                  <a href="/surveys/<%= s.session_id %>/workspace" class="inline-block px-3 py-1 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded transition">Workspace</a>
                  <a href="/surveys/<%= s.session_id %>/report" class="inline-block px-3 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-semibold rounded border border-emerald-200 transition">Report</a>
                  <% if (user && user.role === 'Admin') { %>
                    <form action="/surveys/<%= s.session_id %>/delete" method="POST" class="inline-block" onsubmit="return confirm('Delete survey \"<%= s.session_name %>\" and all its measurement points?')">
                      <button type="submit" class="inline-block px-3 py-1 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-semibold rounded border border-red-200 transition">Delete</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" class="py-8 text-center text-slate-500 text-sm">No survey sessions yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
