<%- include('../partials/header') %>

<div class="max-w-lg mx-auto px-4 sm:px-6 py-8">
  <div class="mb-5">
    <a href="/surveys" class="text-xs font-semibold text-slate-500 hover:text-slate-700 inline-flex items-center mb-3 min-h-[36px]">
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      Back to Sessions
    </a>
    <h1 class="text-xl sm:text-2xl font-bold text-slate-900">New Survey Session</h1>
    <p class="text-xs text-slate-600 mt-1">Select a campus floor plan to start logging RSSI signal data</p>
  </div>

  <div class="bg-white p-5 sm:p-8 rounded-xl border border-slate-200 shadow-sm">
    <%- include('../partials/alerts') %>

    <form action="/surveys" method="POST" class="space-y-5">
      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Session Name</label>
        <input type="text" name="session_name" required placeholder="e.g. Science Dept Floor 2 Wi-Fi Audit" class="w-full px-3 py-3 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Target Building & Floor</label>
        <select name="floor_id" required class="w-full px-3 py-3 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          <option value="">-- Select Floor Plan --</option>
          <% buildings.forEach(b => { %>
            <% (b.floors || []).forEach(f => { %>
              <option value="<%= f.floor_id %>">
                <%= b.name %> (<%= b.code %>) — Floor <%= f.floor_number %>
              </option>
            <% }); %>
          <% }); %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Notes / Scope</label>
        <textarea name="notes" rows="3" placeholder="Environmental conditions, peak hours, diagnostic goals..." class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none resize-none"></textarea>
      </div>

      <div class="flex flex-col-reverse sm:flex-row justify-end gap-3 pt-2">
        <a href="/surveys" class="text-center px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm rounded-lg transition min-h-[44px] flex items-center justify-center">Cancel</a>
        <button type="submit" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm rounded-lg shadow-sm transition min-h-[44px]">Launch Workspace &rarr;</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
