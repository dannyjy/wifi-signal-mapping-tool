<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <%- include('../partials/alerts') %>

  <!-- Header -->
  <div class="flex flex-col gap-4 mb-6 pb-4 border-b border-slate-200 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <a href="/surveys" class="text-xs font-semibold text-slate-500 hover:text-slate-700 inline-flex items-center mb-2 min-h-[36px]">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        All Survey Sessions
      </a>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900">Executive Wi-Fi Diagnostic Report</h1>
      <p class="text-xs text-slate-600 mt-1">Signal Quality Analysis — University of Juba</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/surveys/<%= session.session_id %>/workspace" class="inline-flex items-center justify-center px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-lg transition min-h-[44px]">
        Workspace
      </a>
      <a href="/surveys/<%= session.session_id %>/report/pdf" target="_blank" class="inline-flex items-center justify-center px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-lg shadow-sm transition min-h-[44px]">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        Download PDF
      </a>
    </div>
  </div>

  <!-- Report Card -->
  <div class="bg-white p-5 sm:p-8 rounded-xl border border-slate-200 shadow-md space-y-6 sm:space-y-8">

    <!-- Institutional Header -->
    <div class="bg-slate-900 text-white p-4 sm:p-6 rounded-lg border-l-4 border-emerald-500">
      <h2 class="text-base sm:text-lg font-bold text-white tracking-wide">UNIVERSITY OF JUBA</h2>
      <p class="text-xs text-slate-300 mt-0.5">ICT Infrastructure & Wireless Network Engineering Department</p>
      <div class="mt-3 text-xs text-slate-400 space-y-1">
        <p><span class="text-slate-300 font-semibold">Building:</span> <%= session.building_name %> (<%= session.building_code %>) — Floor <%= session.floor_number %></p>
        <p><span class="text-slate-300 font-semibold">Surveyor:</span> <%= session.surveyor_name || 'System Surveyor' %> | <%= new Date(session.survey_date).toLocaleDateString() %></p>
      </div>
      <div class="mt-3">
        <span class="px-3 py-1 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs font-bold rounded-full uppercase tracking-wider">
          <%= session.status %>
        </span>
      </div>
    </div>

    <!-- KPI Cards — 2-col on mobile, 4-col on sm+ -->
    <div>
      <h3 class="text-xs sm:text-sm font-bold text-slate-900 uppercase tracking-wider mb-3">Summary Metrics</h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="p-3 sm:p-4 bg-slate-50 rounded-lg border border-slate-200 text-center">
          <span class="block text-[10px] sm:text-[11px] font-semibold text-slate-500 uppercase">Avg Signal</span>
          <span class="block text-lg sm:text-xl font-bold font-mono <%= metrics.avgRSSI && parseFloat(metrics.avgRSSI) >= -65 ? 'text-emerald-600' : 'text-red-600' %> mt-1">
            <%= metrics.avgRSSI ? metrics.avgRSSI : 'N/A' %><span class="text-sm"> dBm</span>
          </span>
        </div>
        <div class="p-3 sm:p-4 bg-slate-50 rounded-lg border border-slate-200 text-center">
          <span class="block text-[10px] sm:text-[11px] font-semibold text-slate-500 uppercase">Sample Points</span>
          <span class="block text-lg sm:text-xl font-bold text-slate-900 mt-1"><%= metrics.totalPoints %></span>
        </div>
        <div class="p-3 sm:p-4 bg-slate-50 rounded-lg border border-slate-200 text-center">
          <span class="block text-[10px] sm:text-[11px] font-semibold text-slate-500 uppercase">Dead Zones</span>
          <span class="block text-lg sm:text-xl font-bold text-red-600 mt-1"><%= metrics.percentages.poor %>%</span>
        </div>
        <div class="p-3 sm:p-4 bg-slate-50 rounded-lg border border-slate-200 text-center">
          <span class="block text-[10px] sm:text-[11px] font-semibold text-slate-500 uppercase">Deployed APs</span>
          <span class="block text-lg sm:text-xl font-bold text-blue-600 mt-1"><%= (session.aps || []).length %></span>
        </div>
      </div>
    </div>

    <!-- Threshold Progress Bars -->
    <div>
      <h3 class="text-xs sm:text-sm font-bold text-slate-900 uppercase tracking-wider mb-3">Signal Quality Distribution</h3>
      <div class="space-y-3 text-xs">
        <% const bars = [
          { label: 'Excellent (≥ -50 dBm)', color: 'bg-emerald-500', textColor: 'text-emerald-600', count: metrics.breakdown.excellent, pct: metrics.percentages.excellent },
          { label: 'Good (-50 to -60 dBm)', color: 'bg-blue-500', textColor: 'text-blue-600', count: metrics.breakdown.good, pct: metrics.percentages.good },
          { label: 'Acceptable (-60 to -70 dBm)', color: 'bg-amber-500', textColor: 'text-amber-600', count: metrics.breakdown.acceptable, pct: metrics.percentages.acceptable },
          { label: 'Poor / Dead Zone (< -70 dBm)', color: 'bg-red-500', textColor: 'text-red-600', count: metrics.breakdown.poor, pct: metrics.percentages.poor }
        ]; %>
        <% bars.forEach(b => { %>
          <div>
            <div class="flex justify-between font-semibold mb-1">
              <span class="<%= b.textColor %> truncate pr-2"><%= b.label %></span>
              <span class="flex-shrink-0"><%= b.count %> pts (<%= b.pct %>%)</span>
            </div>
            <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
              <div class="<%= b.color %> h-full rounded-full" style="width: <%= b.pct %>%"></div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- AP Table — horizontally scrollable on mobile -->
    <div>
      <h3 class="text-xs sm:text-sm font-bold text-slate-900 uppercase tracking-wider mb-3">Access Points (APs)</h3>
      <div class="overflow-x-auto border border-slate-200 rounded-lg -mx-1">
        <table class="w-full text-left text-xs border-collapse min-w-[480px]">
          <thead class="bg-slate-900 text-white font-bold uppercase text-[10px]">
            <tr>
              <th class="py-2.5 px-3">SSID</th>
              <th class="py-2.5 px-3">MAC Address</th>
              <th class="py-2.5 px-3">Channel</th>
              <th class="py-2.5 px-3">Tx Power</th>
              <th class="py-2.5 px-3">Coords</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (session.aps && session.aps.length > 0) { %>
              <% session.aps.forEach(ap => { %>
                <tr class="hover:bg-slate-50">
                  <td class="py-2.5 px-3 font-bold text-slate-900"><%= ap.ssid %></td>
                  <td class="py-2.5 px-3 font-mono text-slate-600"><%= ap.mac_address || 'N/A' %></td>
                  <td class="py-2.5 px-3 font-semibold text-slate-700"><%= ap.channel || 'Auto' %></td>
                  <td class="py-2.5 px-3 font-mono"><%= ap.tx_power_dbm %> dBm</td>
                  <td class="py-2.5 px-3 font-mono text-slate-500">(<%= ap.x_pos %>, <%= ap.y_pos %>)</td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="py-4 text-center text-slate-400 italic">No Access Points annotated.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Engineering Recommendations -->
    <div class="p-4 sm:p-5 rounded-lg bg-red-50 border border-red-200">
      <h4 class="text-xs font-bold text-red-900 uppercase tracking-wider mb-2">Engineering Assessment & Recommendations</h4>
      <p class="text-xs text-red-800 leading-relaxed">
        <% if (metrics.percentages.poor > 20) { %>
          <strong class="font-bold">CRITICAL:</strong> <%= metrics.percentages.poor %>% of measurements are in dead zones (&lt; -70 dBm). Immediate additional AP deployment is required.
        <% } else if (metrics.percentages.poor > 5) { %>
          <strong class="font-bold">MODERATE:</strong> Minor dead zones detected (<%= metrics.percentages.poor %>%). Consider adjusting Tx Power or repositioning existing APs.
        <% } else { %>
          <strong class="font-bold">OPTIMAL:</strong> Excellent spatial wireless coverage. Over 95% of the floor plan maintains RSSI &ge; -70 dBm.
        <% } %>
      </p>
    </div>

    <% if (session.notes) { %>
      <div>
        <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2">Surveyor Field Notes</h4>
        <p class="text-sm text-slate-600 bg-slate-50 p-3 rounded-lg border border-slate-200"><%= session.notes %></p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
